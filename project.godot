; Engine configuration file.
config_version=5

[application]
config/name="Tinyverse C# Cosmos Simulator"
run/main_scene="res://MainCosmos.tscn"
config/features=PackedStringArray("4.3", "C#", "Mobile")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]
project/assembly_name="TinyverseCSharp"

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2

[resource]
export/android/android_sdk_path = "/usr/local/lib/android/sdk"
export/android/java_sdk_path = "/opt/hostedtoolcache/Java_Temurin-Hotspot_jdk/17.0.*/x64"
